# ==========================================
# CONFIGURAZIONE BOT FRANCHINO PER DISCORD
# ==========================================

# Token del bot Discord (OBBLIGATORIO)
# Ottienilo da: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=inserisci_qui_il_tuo_token_discord

# Prefisso comandi chat (predefinito: !)
COMMAND_PREFIX=!

# Credenziali Spotify API (OPZIONALE ma consigliato per playlist lunghe)
# Ottienile gratis su: https://developer.spotify.com/dashboard
# Se non le inserisci, Franchino userà il parser integrato per brani e playlist!
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Impostazioni audio e riproduzione
DEFAULT_VOLUME=70
INACTIVITY_TIMEOUT=180

# Proxy opzionale per YouTube (SOCKS5 / HTTP, es. socks5://127.0.0.1:1080 per aggirare blocchi IP datacenter)
YOUTUBE_PROXY=

# =========================================================================
# CENTRAL KNOWLEDGE HUB & LOCAL AI (Configurati automaticamente via Docker)
# =========================================================================
# DB_HOST=central-hub-db
# DB_PORT=5432
# DB_USER=franchino_admin
# DB_PASS=franchino_secure_pass
# DB_NAME=franchino_hub
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=gemma2:2b
#
# NOTA PER ALTRI PROGETTI SUL SERVER:
# Qualsiasi altro container o script python/node sul server Oracle può collegarsi
# all'Hub Centrale condiviso usando la stringa di connessione:
# postgresql://franchino_admin:franchino_secure_pass@127.0.0.1:5432/franchino_hub
