# ==========================================
# CONFIGURAZIONE BOT FRANCHINO PER DISCORD
# ==========================================

# Token del bot Discord (OBBLIGATORIO)
# Ottienilo da: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=inserisci_qui_il_tuo_token_discord

# Prefisso comandi chat (predefinito: !)
COMMAND_PREFIX=!

# Credenziali Spotify API (OPZIONALE ma consigliato)
# Ottienile gratis su: https://developer.spotify.com/dashboard
# Se le lasci vuote Franchino usa il parser integrato, ma NON potrà arricchire
# i brani con titolo/artista/copertina ufficiali Spotify.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# =========================================================================
# YOUTUBE: BYPASS DEL BOT-CHECK DA DATACENTER (Oracle / AWS / Docker)
# =========================================================================
# Da IP datacenter YouTube risponde "Sign in to confirm you're not a bot" e la
# ricerca ripiega su SoundCloud. La soluzione stabile è il PO token provider,
# già incluso in docker-compose.yml:
#
#   1. avvia il provider:   docker compose --profile pot up -d
#   2. imposta qui sotto:   POT_PROVIDER_URL=http://bgutil-provider:4416
#   3. ricostruisci:        ./update.sh
#
# Se resta vuoto il bot funziona lo stesso (fallback in ~2s invece dei 22s
# che impiegava prima a forza di ritentare), ma l'audio arriva da SoundCloud.
POT_PROVIDER_URL=

# Per quanti secondi non ritentare YouTube dopo un bot-check (default 300)
YOUTUBE_BLOCK_COOLDOWN=300

# Motore musicale preferito: youtube (default) | soundcloud
MUSIC_PREFER=youtube

# SoundCloud come ultima spiaggia:
#   1 = sì (default)   -> se YouTube è bloccato, Franchino suona comunque
#   0 = no             -> Franchino avvisa che il brano non è disponibile
MUSIC_ALLOW_SOUNDCLOUD=1

# Impostazioni audio e riproduzione
DEFAULT_VOLUME=70
INACTIVITY_TIMEOUT=180

# Proxy opzionale per YouTube (SOCKS5 / HTTP, es. socks5://127.0.0.1:1080 per aggirare blocchi IP datacenter)
YOUTUBE_PROXY=

# =========================================================================
# CENTRAL KNOWLEDGE HUB & LOCAL AI (Configurati automaticamente via Docker)
# =========================================================================
# DB_HOST=central-hub-db
# DB_PORT=5432
# DB_USER=franchino_admin
# DB_PASS=franchino_secure_pass
# DB_NAME=franchino_hub
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=gemma2:2b
